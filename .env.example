# Local development only. The application will refuse APP_ENV=production.
APP_ENV=development
DATABASE_URL=sqlite:///giftbridge.db
JWT_SECRET=REPLACE_WITH_RANDOM_LOCAL_DEVELOPMENT_SECRET
ENABLE_DEMO_FUNDING=true
# GIFTBRIDGE_NO_BROWSER=1

# v0.6 optional developer-only callback test settings (DISABLED BY DEFAULT)
ENABLE_SANDBOX_WEBHOOK=false
# For webhook integration exercise only; use >=24 random characters and never commit secrets.
# SANDBOX_WEBHOOK_SECRET=SET_YOUR_OWN_TEST_SECRET_THAT_IS_AT_LEAST_24_CHARACTERS
